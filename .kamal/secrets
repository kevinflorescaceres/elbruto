# Sin valores: se leen de fuera del repo en cada deploy.
POSTGRES_PASSWORD=$(cat ~/.config/camorra/postgres-password)
DATABASE_URL=postgresql://camorra:$POSTGRES_PASSWORD@camorra-db:5432/camorra
DIRECT_URL=$DATABASE_URL

# Tema de ntfy para los reportes de la beta (https://ntfy.sh/<tema>). Es secreto: quien
# sepa el tema lee los reportes. Si falta, se guardan igual pero no avisan.
NTFY_URL=$(cat ~/.config/camorra/ntfy-url 2>/dev/null)

# Backups a R2: credenciales compartidas de Pantheon, fuera del repo. Si faltan, el
# accessory `backup` no arranca, pero el deploy de la app no se ve afectado.
S3_ENDPOINT=$(cat ~/.config/pantheon/r2-endpoint 2>/dev/null)
S3_ACCESS_KEY_ID=$(cat ~/.config/pantheon/r2-access-key-id 2>/dev/null)
S3_SECRET_ACCESS_KEY=$(cat ~/.config/pantheon/r2-secret-access-key 2>/dev/null)

# Certificado de origen de Cloudflare para camorra.florescaceres.cl (SSL/TLS > Origin Server).
# Sin estos archivos el deploy falla.
CERTIFICATE_PEM=$(cat ~/.config/camorra/origin-cert.pem)
PRIVATE_KEY_PEM=$(cat ~/.config/camorra/origin-key.pem)
