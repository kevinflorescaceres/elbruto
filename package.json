{
  "name": "camorra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "balance": "pnpm --filter @camorra/engine balance",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @camorra/server exec prisma migrate dev",
    "db:deploy": "pnpm --filter @camorra/server exec prisma migrate deploy",
    "db:test:prepare": "PRISMA_TARGET=test pnpm --filter @camorra/server exec prisma migrate deploy",
    "seed": "pnpm --filter @camorra/server seed",
    "admin": "pnpm --filter @camorra/server admin",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
