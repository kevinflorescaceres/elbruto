# --- Base de datos ---
# En local: Postgres propio. En produccion: Supabase.
#
# DATABASE_URL  la usa la aplicacion. Con Supabase, el POOLER (puerto 6543).
# DIRECT_URL    la usan las migraciones. Con Supabase, la conexion DIRECTA (5432).
#               A traves de un pooler en modo transaccion, migrate falla.
DATABASE_URL=postgresql://camorra:camorra@localhost:5432/camorra
DIRECT_URL=postgresql://camorra:camorra@localhost:5432/camorra
TEST_DATABASE_URL=postgresql://camorra:camorra@localhost:5432/camorra_test

# --- Aplicacion ---
GAME_TIMEZONE=America/Santiago
PORT=3000
# Dominio publico real. Sin el, los enlaces compartidos dicen localhost.
PUBLIC_URL=https://camorra.fly.dev
# Saltos de proxy por delante. 1 en Fly.io. Sin esto el rate limit por IP no sirve.
TRUST_PROXY=1
