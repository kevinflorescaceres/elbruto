# --- Base de datos ---
# En local: Postgres propio. En produccion: el accessory `db` de Kamal (config/deploy.yml).
#
# DATABASE_URL  la usa la aplicacion.
# DIRECT_URL    la usan las migraciones. Si algun dia hay un pooler en modo transaccion
#               por delante, esta debe ir directa: a traves del pooler, migrate falla.
DATABASE_URL=postgresql://camorra:camorra@localhost:5432/camorra
DIRECT_URL=postgresql://camorra:camorra@localhost:5432/camorra
TEST_DATABASE_URL=postgresql://camorra:camorra@localhost:5432/camorra_test

# --- Aplicacion ---
GAME_TIMEZONE=America/Santiago
PORT=3000
# Dominio publico real. Sin el, los enlaces compartidos dicen localhost.
PUBLIC_URL=https://camorra.florescaceres.cl
# Saltos de proxy por delante: 1 con kamal-proxy, 2 si ademas va el proxy de Cloudflare.
# Sin esto el rate limit por IP no sirve.
TRUST_PROXY=1
